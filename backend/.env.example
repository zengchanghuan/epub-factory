# DeepSeek Configuration (OpenAI-compatible API)
OPENAI_API_KEY=sk-your_actual_api_key_here
OPENAI_MODEL=deepseek-flash
OPENAI_BASE_URL=https://api.deepseek.com/v1

# For DeepSeek, you would use:
# OPENAI_API_KEY=sk-your_deepseek_key
# OPENAI_MODEL=deepseek-flash
# OPENAI_BASE_URL=https://api.deepseek.com/v1
# UI 翻译模型默认值；普通段落走 flash，坏段落补译可自动升级到 pro。
EPUB_DEFAULT_TRANSLATION_MODEL=deepseek-flash
# EPUB_TRANSLATION_PROACTIVE_QUALITY_MODEL_ENABLED=0  # 首轮复杂段落也优先 Flash

# 翻译质量：temperature 建议 1.3（DeepSeek 文档推荐），见 https://api-docs.deepseek.com/zh-cn/quick_start/parameter_settings
# OPENAI_TEMPERATURE=1.3

# Translation resilience (optional): fallback URLs/models, timeout, retries, concurrency
# OPENAI_BASE_URL_FALLBACKS=https://backup.example.com/v1
# OPENAI_MODEL_FALLBACKS=deepseek-chat,deepseek-reasoner
# 单段补译反复质检失败后，自动升级到更稳的模型，仅作用于该段补译。
# EPUB_TRANSLATION_QUALITY_FALLBACK_MODEL=deepseek-v4-pro
# EPUB_TRANSLATION_PRO_FALLBACK_AFTER_RETRIES=1
# OPENAI_REQUEST_TIMEOUT=25
# OPENAI_MAX_RETRIES=2
# OPENAI_CONCURRENCY=5
# EPUB_TRANSLATION_BATCH_MAX_CHARS=6000

# 付费繁简精校：仅风险词审阅，与 translation_quality=literary 无关。
# 单段完整请求 UTF-8 字节 + 128 framing 的工程上界，不是实际 token 数；报价前/执行前同一检查。
# L4_MAX_INPUT_BYTES_PER_PARA=8192
# 单次输出 token 硬上限；当前风险词 JSON 请求还取 min(此值, 1024)。
# L4_MAX_TOKENS_PER_PARA=4096
# 整书安全预算：派发前按输入字节上界+最大输出预留，成功后以供应商 actual usage 结算。
# 失败/未知用量保留预留额度；费用展示只认请求账本，超界停止交付而非静默降级。
# L4_MAX_TOKENS_PER_BOOK=2000000

# EPUB 翻译走快速 MapReduce 新链路（预处理→章节并发→Reduce 回写）。
# 默认 1=开启；设为 0 暂停翻译（新请求付款前拒绝，旧单不发起模型请求）。
# EPUB/DOCX/Markdown 共用该执行器；不再回退缺少已购质量/策略配置的旧内联翻译。
# EPUB_FAST_TRANSLATION=1
# 默认只跳过包含图片媒体的非文本块；有文字的图片说明会翻译并接受成品 QA。
# 普通解释型脚注走文本节点专项翻译，纯引用型脚注保留原文。
# EPUB_SKIP_IMAGE_NOTE_CHUNKS=1
# 单个段落跨批量重试、单段补译、文本节点补译和失败队列的累计重试预算。
# EPUB_TRANSLATION_CHUNK_RETRY_BUDGET=6

# 翻译前图书探针：默认复用当前 OPENAI_* 通道和任务所选模型，不会自动切换供应商。
# 普通模型失败时回退本地保守规则；取消、账本/限流/预算拒绝不会被回退吞掉。
# 若单独指定模型，仍应纳入模型白名单与供应商授权。
# EPUB_BOOK_PROFILER_ENABLED=1
# EPUB_BOOK_PROFILER_MODEL=deepseek-flash
# EPUB_BOOK_PROFILER_MAX_CHARS=18000
# EPUB_BOOK_PROFILER_TIMEOUT=75

# 付款前画像/术语：持久预算与同书缓存，使用订单/费用账本数据库。
# 以下是可配置的工程预算，不是供应商限额、真实 token 或费用估算。
# units = 请求 JSON UTF-8 字节 + 512 framing + 最大输出 token；失败/未知用量不退还。
# 用户与可信客户端 IP 均受 UTC 每日上限约束；换会话/模型不重置同书预算。
# EPUB_PREFLIGHT_MAX_OUTPUT_TOKENS=4096
# EPUB_PREFLIGHT_BOOK_REQUESTS=8
# EPUB_PREFLIGHT_BOOK_UNITS=200000
# EPUB_PREFLIGHT_DAILY_REQUESTS=64
# EPUB_PREFLIGHT_DAILY_UNITS=1000000
# EPUB_PREFLIGHT_CACHE_SECONDS=3600
# 同一用户/匿名会话的源文件及配置命中缓存时不重复调用；运行中返回 409。
# 分析进程异常退出后，不按 TTL 抢占未知请求；同一键在当前 UTC 日内保持拒绝。

# Redis 跨 Worker 令牌桶：默认关闭；必须显式启用并配置正数 RPM/TPM。
# 建议先按供应商实际配额压测，再逐步启用，避免过低限制拖慢付费任务。
# EPUB_LLM_RATE_LIMITER_ENABLED=0
# 启用后配置不全、Redis 不可用默认阻止新增模型调用；显式应急降级才设 1。
# EPUB_LLM_RATE_LIMIT_FAIL_OPEN=0
# EPUB_LLM_RPM=240
# EPUB_LLM_TPM=600000
# EPUB_LLM_RATE_LIMIT_MAX_WAIT=90
# EPUB_LLM_RATE_LIMIT_KEY_PREFIX=epub:llm:bucket
# EPUB_LLM_GLOBAL_HEALTH_ENABLED=0
# EPUB_LLM_GLOBAL_HEALTH_TTL_SECONDS=600

# ─── LLM 模型白名单（防止误用高价模型导致成本失控）──────────────────────────
# 默认白名单: deepseek-chat, deepseek-flash, deepseek-v4-pro, deepseek-reasoner, deepseek-coder, gpt-4o-mini
# Flash 的两个旧别名仅用于兼容；配置任一官方 Flash 别名会放行同组别名，不改写历史缓存。
# 除 deepseek-v4-pro 外，任何包含 -pro / o1- / claude-opus 关键词的模型都会拒绝（黑名单）
# 不设置则使用默认白名单；如需扩展（如新增 gpt-4o-mini-2024-07-18），逗号分隔
# LLM_MODEL_ALLOWLIST=deepseek-chat,deepseek-flash,deepseek-v4-pro,deepseek-reasoner,gpt-4o-mini

# 持久化任务列表（任务中心、重启后任务不丢失）
# 不设置则使用内存存储，重启后任务列表清空
# DATABASE_URL=sqlite:///./epub_jobs.db
# DATABASE_URL=postgresql://user:password@host:5432/epub_factory

# Background Task Infrastructure
REDIS_URL=redis://127.0.0.1:6379/0
CELERY_BROKER_URL=redis://127.0.0.1:6379/0
# 已付款投递重试独立运行在 API 进程，不依赖书籍队列空闲。
# 仅持久化 Store + Broker 配置时自动启动；关闭会停止自动重试，不删除记录。
# JOB_DISPATCH_ENABLED=1
CELERY_RESULT_BACKEND=redis://127.0.0.1:6379/1

# 文本 PDF → 原文 EPUB 独立入口，默认关闭；不是 PDF 翻译/OCR/精校/批量。
# 启用还要求持久化 Store + Celery；准备进程需 Linux 硬内存隔离及 EPUBCheck。
# Mac 可开发/检查，但没有硬隔离的候选不能进入真实付款。
# PDF_TEXT_CONVERSION_ENABLED=0
# 付款前准备的 UTC 每日工程预算，失败/取消也计次，不占普通免费额度。
# PDF_PREPARATION_PER_IP_DAILY=3
# PDF_PREPARATION_TOTAL_DAILY=100
# 文件上限 min(MAX_FILE_SIZE_MB, 50)，页数上限 500；沿用现有普通转换价格。
# 先生成私有成品并冻结源稿/成品哈希、版本、金额，确认风险后再付款；交付不重跑解析。
# 关闭入口不影响已确认订单继续支付/下载。勿删除 outputs/.pdf-prepared-* 中待交付成品。

# 用户主动填写邮箱后，任务终态发送结果页面链接；不发送书籍附件。
# 未配置 SMTP 时前端明确提示不可用，不会宣称已发送。
# NOTIFY_EMAIL_ENABLED=0
# SMTP_HOST=smtp.qq.com
# SMTP_PORT=465
# SMTP_SECURITY=ssl
# SMTP_USER=249998620@qq.com
# SMTP_FROM=249998620@qq.com
# SMTP_PASSWORD=  # QQ 邮箱 SMTP 授权码，只在本机/服务器配置，勿提交
# SMTP_TIMEOUT_SECONDS=15
# SITE_BASE_URL=https://fixepub.com
# EMAIL_DISPATCH_INTERVAL_SECONDS=30
# API 进程的后台通知线程独立于整书队列，进程重启会继续检查待发通知。

# 商户新成交提醒：与顾客主动订阅的结果通知独立，共用上述 SMTP 配置。
# 仅在服务端验证支付后入队，按商户订单号去重；批量订单一封，测试订单默认不发。
# 收到已验证支付后立即尝试发送，实际到达时间取决于邮箱服务；不全量补发历史订单。
# OWNER_PAYMENT_EMAIL_ENABLED=1
# OWNER_PAYMENT_EMAIL_TO=249998620@qq.com

# 后台 Token/费用汇总接口（GET /api/v2/admin/translation-stats）可选鉴权
# ADMIN_SECRET=your_secret_string

# 逐请求模型费用账本与任务共用 DATABASE_URL，部署时保留数据库。
# 默认内置 DeepSeek 官方 CNY 价目（2026-09-18 核对，缓存/峰谷分计）。
# 其他供应商或新价目使用版本化 JSON 数组，格式见 docs/LLM-COST-LEDGER.md。
# 不配置相应渠道价格时仍记录实际 usage，但费用标为待核实，而不是 0。
# LLM_PRICING_FILE=/absolute/path/to/llm-pricing.json

# CORS: 生产环境建议仅放你的正式域名（逗号分隔）
# CORS_ALLOW_ORIGINS=https://fixepub.com,https://www.fixepub.com

# 反向代理白名单（CIDR，逗号分隔）：
# 只有 TCP 对端落在这些网段时，才会信任 X-Real-IP / X-Forwarded-For 头。
# 部署在 Nginx 后端时保持默认（127.0.0.1/32）即可；如果有多级代理需要把外层 LB 的内网段也加进来。
# TRUSTED_PROXIES=127.0.0.1/32,::1/128

# ─── 资源上限（按部署机器规格调）─────────────────────────────────────
# 单文件大小上限（MB）。默认 20，按机器内存与公网带宽分级：
#   2C2G / 3Mbps（小机）：建议 60（覆盖 95% 带插图 EPUB；用户下载 ~2分40秒）
#   2C4G / 5Mbps（推荐）：建议 80（覆盖 99% EPUB；下载 ~2分10秒）
#   4C8G / 8Mbps+      ：建议 150（含画册/扫描）
# MAX_FILE_SIZE_MB=60

# Celery worker 并发数（必须显式，默认会跑满 CPU 核数 → 易 OOM）。
# 2GiB 内存机器强烈建议保持 1；升 4GiB 后可调到 2。
# CELERY_WORKER_CONCURRENCY=1
# CELERY_TASK_TIME_LIMIT=1800        # 单任务硬超时（秒），默认 30 分钟
# CELERY_TASK_SOFT_TIME_LIMIT=1500   # 软超时（秒），任务侧可优雅退出
# CELERY_HOUSEKEEPING_SOFT_TIME_LIMIT=1500 # 维护队列独立软时限，保留原预算，不影响整书
# CELERY_HOUSEKEEPING_TIME_LIMIT=1800      # 维护硬时限（1..3600，必须大于软时限）
# 维护 Worker 固定 concurrency=1；隔离不等于实时 SLA，长对账仍会等待。
# systemd 维护单元 TimeoutStopSec 应大于维护硬时限（默认草稿 1900 秒）。
# EPUB_BOOK_SOFT_TIME_LIMIT=7200    # 整书转换独立软超时，默认 2 小时
# EPUB_BOOK_TIME_LIMIT=7500         # 整书硬超时，必须大于整书软超时
# CELERY_VISIBILITY_TIMEOUT=10800   # Redis 消息可见性超时，必须大于所有任务硬超时

# 支付回调校验：建议配置商户 PID（seller_id）做二次验签
# ALIPAY_SELLER_ID=2088xxxxxxxxxxxx

# 翻译任务的应付金额（元，字符串形式以保持小数精度），下单与回调都用同一个值。
# TRANSLATION_PRICE_CNY=0.01

# AI 翻译默认采用字符阶梯价：前 30 万 / 30-100 万 / 100 万以上。
# 标准 Flash 最低 3.99 元；高质量、文学和 Pro 分别应用倍率。
# TRANSLATION_PRICE_PER_1K=0.05
# TRANSLATION_PRICE_300K_TO_1M_PER_1K=0.035
# TRANSLATION_PRICE_OVER_1M_PER_1K=0.025
# TRANSLATION_MIN_PRICE=3.99
# TRANSLATION_MAX_PRICE=99999
# TRANSLATION_HIGH_QUALITY_MULTIPLIER=1.5
# TRANSLATION_LITERARY_MULTIPLIER=2
# TRANSLATION_PRO_MODEL_MULTIPLIER=3.4

# 非 AI 格式转换 0.99 元/本，独立 EPUB 格式修复 2.99 元/本。
# AI 精校不包含在转换价中，按正文有效字数另行加价。
# 批量转换按文件数相乘；标准 Flash AI 翻译最低价为 3.99。
# CONVERSION_PRICE_CNY=0.99
# REPAIR_PRICE_CNY=2.99
# 已创建订单按各自冻结的报价及 expected_amount 验款，不随单价修改重新定价。

# 独立修复：所有 API 进程必须共享同一个本机持久目录，不支持 NFS/多主机。
# 默认仍为 /tmp/epub-repair；生产应另行迁移至私有持久卷，部署不会自动搬旧订单。
# REPAIR_UPLOAD_DIR=/var/lib/epub-factory/repair
# 同一目录全局执行上限 1..4，默认 1；首次使用会固定在 .repair-executor.json。
# 修改前须排空任务、停止所有 API 并同步修改配置文件，详见 docs/DEPLOY.md。
# REPAIR_CONCURRENCY=1

# 旧任务（无 access_token）的 session/IP 兜底鉴权时间窗（天，超过则直接拒绝）。
# LEGACY_ACCESS_WINDOW_DAYS=30

# 任务 access_token 默认有效期（天）；过期后需要重新发起任务获取新 token。
# ACCESS_TOKEN_TTL_DAYS=7

# 下载链接签名密钥（HMAC-SHA256）；未配置则禁用签名 URL，下载只接受 token 鉴权。
# 建议生成一段足够随机的字符串，如 `openssl rand -hex 32`。
# DOWNLOAD_SIGN_SECRET=replace_with_a_long_random_string
# DOWNLOAD_SIGN_TTL_SECONDS=600

# 大模型余额监控（每天 08:00 查询，低于阈值写 ERROR → CLS 告警）
# BALANCE_WARN_CNY=10            余额低于多少元触发告警（默认 10）
# BALANCE_CHECK_PROVIDER=deepseek  提供商标识，仅用于日志
# BALANCE_CHECK_HOUR=8           每天几点检查（默认 08:00）
# BALANCE_CHECK_MINUTE=0

# 支付对账 cron 配置（Celery Beat 驱动）
# RECONCILE_STALE_MINUTES=30      订单滞留多少分钟后才纳入对账（默认 30）
# RECONCILE_TIMEOUT_HOURS=2       超过多少小时仍未付款则自动关单（默认 2）
# RECONCILE_CRON_HOUR=2           每天几点执行（默认凌晨 2 点，Asia/Shanghai）
# RECONCILE_CRON_MINUTE=0

# 结构化日志文件路径（供 LogListener/CLS 采集）；不设置则只输出到 stdout
# 注意：路径需放在子目录下，LogListener 通配符 /**/app.log 才能匹配
# LOG_FILE=/var/log/epub-factory/api/app.log

# 错误上报：设置后 job 失败/HTTP 5xx 会自动上报到 Sentry
# 在 Sentry 项目 Settings → Client Keys 复制 DSN
# SENTRY_DSN=https://your-key@your-org.ingest.sentry.io/project-id
#
# 运行环境标签（显示在 Sentry Issues 的 environment 过滤器）
# APP_ENV=production
#
# 性能追踪采样率（0.0-1.0）；生产建议 0.05~0.1 节省配额
# SENTRY_TRACES_RATE=0.1

# ─── 用户认证 (User Auth) ────────────────────────────────────────────────────
# JWT 签名密钥：生产环境必须替换为足够随机的字符串（openssl rand -hex 32）
# 缺失或仍为公开占位值时，账号登录返回 503，已有账号 JWT 不接受；不影响有效任务令牌。
# JWT_SECRET=replace_with_a_long_random_secret_key
# JWT_EXPIRE_DAYS=7

# ─── 短信通道（手机号验证码登录）────────────────────────────────────────
# 通道选择：aliyun（默认）/ tencent。未配置任何通道时走开发兜底（日志打印验证码）。
# SMS_PROVIDER=tencent

# 阿里云 dysmsapi（在阿里云 RAM 控制台创建子账号，授权 AliyunDysmsFullAccess）
# ALIYUN_ACCESS_KEY_ID=your_access_key_id
# ALIYUN_ACCESS_KEY_SECRET=your_access_key_secret
# SMS_SIGN_NAME=你的短信签名
# SMS_TEMPLATE_CODE=SMS_XXXXXXXXX

# 腾讯云 SMS（控制台 → 短信 → 应用管理 + 签名/模板审核）
# 个人账户开通即送 200 条免费额度，3 个月有效。
# TENCENT_SECRET_ID=AKIDxxxxxxxxxxxxxx
# TENCENT_SECRET_KEY=xxxxxxxxxxxxxxxxxxxx
# TENCENT_SMS_APP_ID=1400xxxxxx          # 短信应用 SdkAppId（10 位数字）
# TENCENT_SMS_SIGN=FixEpub               # 已审核通过的签名（不含【】）
# TENCENT_SMS_TEMPLATE_ID=2xxxxxx        # 已审核通过的模板 ID（数字）
# TENCENT_SMS_REGION=ap-guangzhou        # 默认 ap-guangzhou，按需调整

# Google OAuth 2.0（在 Google Cloud Console → APIs & Services → Credentials 创建）
# GOOGLE_CLIENT_ID=your_client_id.apps.googleusercontent.com
# GOOGLE_CLIENT_SECRET=your_client_secret
# GOOGLE_REDIRECT_URI=https://fixepub.com/api/v2/auth/google/callback

# 微信公众号网页授权（需已认证服务号，在公众平台 → 设置与开发 → 接口权限开启网页授权）
# WECHAT_APP_ID=wx_your_app_id
# WECHAT_APP_SECRET=your_app_secret
# WECHAT_REDIRECT_URI=https://fixepub.com/api/v2/auth/wechat/callback

# 独立订单后台账号；运行 python3 scripts/setup-admin.py 设置密码哈希。
ADMIN_USERNAME=tristan
ADMIN_PASSWORD_HASH=

# Worker 失联恢复（仅持久 Store + 已配置 broker + JOB_DISPATCH_ENABLED 时启动）
# 每 15 秒记录独立心跳；600 秒陈旧只是候选，仍须拿到原 execution lease。
# 工程默认值，非 SLA；最多同 attempt 自动恢复 2 次，随后失败转人工。
# JOB_RECOVERY_ENABLED=1
# JOB_RECOVERY_STALE_SECONDS=600
# JOB_RECOVERY_MAX_ATTEMPTS=2
# 已投递但未开始的排队任务：至少等 1 小时才补发，之后间隔指数退避到 8 倍。
# 不将正常排队计为执行失败，不消耗上面的自动恢复次数。
# JOB_RECOVERY_QUEUE_GRACE_SECONDS=3600
